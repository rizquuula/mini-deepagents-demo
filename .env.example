# Copy to .env and set the key. Run: make run
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
MODEL=deepseek-v4.1-flash
# Hard cap for one model request: prompt + output tokens.
CONTEXT_WINDOW=8192
MAX_OUTPUT_TOKENS=1024
# Tools the model may call: comma-separated names. Leave empty for no tools.
ENABLED_TOOLS=calculate
# Tokens the provider adds once when a request carries tools: measured about 207 for deepseek-v4.1-flash on OpenCode Go, rounded up.
TOOL_OVERHEAD_TOKENS=256
DB_PATH=chat.db
# Logging: DEBUG, INFO, WARNING, or ERROR. Lines go to the terminal and to LOG_FILE.
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
